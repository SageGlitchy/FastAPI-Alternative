# ---- Environment variables for FastAPI demo (docker-compose) ----
# Copy this file to .env and edit the values before running:
#   cp .env.example .env
#   docker compose up

# Secret key for JWT signing in the security tutorial examples.
# Generate a real key with:  openssl rand -hex 32
SECRET_KEY=changeme

# PostgreSQL connection string used by docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/fastapi_dev
